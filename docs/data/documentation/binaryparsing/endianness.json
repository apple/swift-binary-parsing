{"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"symbolKind":"struct","externalID":"s:13BinaryParsing10EndiannessV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Endianness"}],"title":"Endianness","navigatorTitle":[{"text":"Endianness","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"BinaryParsing"}]},"hierarchy":{"paths":[["doc:\/\/BinaryParsing\/documentation\/BinaryParsing"]]},"identifier":{"url":"doc:\/\/BinaryParsing\/documentation\/BinaryParsing\/Endianness","interfaceLanguage":"swift"},"abstract":[{"text":"A value indicating the endianness, or byte order, of an integer value.","type":"text"}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/BinaryParsing\/documentation\/BinaryParsing\/Endianness\/init(isBigEndian:)"],"generated":true},{"identifiers":["doc:\/\/BinaryParsing\/documentation\/BinaryParsing\/Endianness\/isBigEndian","doc:\/\/BinaryParsing\/documentation\/BinaryParsing\/Endianness\/isLittleEndian"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/BinaryParsing\/documentation\/BinaryParsing\/Endianness\/big","doc:\/\/BinaryParsing\/documentation\/BinaryParsing\/Endianness\/little"],"anchor":"Type-Properties","generated":true,"title":"Type Properties"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/BinaryParsing\/documentation\/BinaryParsing\/Endianness\/Equatable-Implementations"],"title":"Default Implementations"}],"relationshipsSections":[{"identifiers":["doc:\/\/BinaryParsing\/SQ","doc:\/\/BinaryParsing\/SH"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"Endianness","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Endianness refers to the sequential order in which bytes are arranged into","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"larger numerical values when stored in memory, in a file on disk, or during"},{"text":" ","type":"text"},{"text":"transmission over a network. When parsing multibyte integer values, you","type":"text"},{"text":" ","type":"text"},{"text":"specify the endianness either by selecting a specific parsing API or by","type":"text"},{"type":"text","text":" "},{"type":"text","text":"providing an "},{"type":"codeVoice","code":"Endianness"},{"text":" value.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In big-endian format, the most significant byte (the “big end”) is stored"},{"text":" ","type":"text"},{"text":"at the lowest memory address, while in little-endian format, the least","type":"text"},{"text":" ","type":"text"},{"text":"significant byte (the “little end”) is stored at the lowest memory address.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For example, the 32-bit integer value "},{"type":"codeVoice","code":"0x12345678"},{"text":" would be stored as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"12 34 56 78"},{"text":" in big-endian format and ","type":"text"},{"type":"codeVoice","code":"78 56 34 12"},{"type":"text","text":" in little-endian"},{"text":" ","type":"text"},{"text":"format.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/binaryparsing\/endianness"]}],"references":{"doc://BinaryParsing/documentation/BinaryParsing/Endianness/init(isBigEndian:)":{"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"text":"isBigEndian","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":